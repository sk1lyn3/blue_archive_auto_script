[Unit]
Description=BAAS WebUI Server
After=network.target

[Service]
Type=simple
# 按实际路径修改下面两行
WorkingDirectory=/opt/blue_archive_auto_script
ExecStart=/opt/blue_archive_auto_script/venv/bin/python webui_server.py --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
